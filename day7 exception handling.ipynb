   "source": [
    "# two types of errors occurs in python"
   ]
  },
  {
   "cell_type": "raw",
   "id": "1f59c4a4",
   "metadata": {},
   "source": [
    ".syntax errors\n",
    ".logical errors(exceptions) "
   ]
  },
  {
   "cell_type": "raw",
   "id": "bae19ba5",
   "metadata": {},
   "source": [
    "to handle exception handling \n",
    "we have try, except, finally"
   ]
  },
  {
   "cell_type": "raw",
   "id": "184ff3a8",
   "metadata": {},
   "source": [
    "try: line of code which has potential or may cause error we use try\n",
    "except: optional block #handling exception (if required)\n",
    "finally: some code....(always executed)\n",
    "finally block is always exceuted after leaving the try statemnet"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "ac129c09",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "enter any number34\n",
      "enter any number44\n",
      "0.7727272727272727\n",
      "im always going to run\n"
     ]
    }
   ],
   "source": [
    "try:\n",
    "    x=int(input('enter any number'))\n",
    "    y=int(input('enter any number'))\n",
    "    ans=x/y\n",
    "    print(ans)\n",
    "except:\n",
    "    print(\"please enter the value othan than zero, you are dividing with 0.\")\n",
    "finally:\n",
    "    print('im always going to run')"
   ]
  },
